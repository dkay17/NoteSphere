{
  "name": "notesphere",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "npm run client",
    "client": "cd client/notesphere && npm start",
    "install-all": "npm install && cd newServer/notesphere_server && npm install && cd ../../client/notesphere && npm install",
    "contract:emit": "cd newServer/notesphere_server && npm run contract:emit",
    "db:init": "cd newServer/notesphere_server && npm run db:init",
    "db:update": "cd newServer/notesphere_server && npm run db:update",
    "migration:plan": "cd newServer/notesphere_server && npm run migration:plan",
    "db:migrate": "cd newServer/notesphere_server && npm run migrate",
    "db:verify": "cd newServer/notesphere_server && npm run db:verify"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "NoteSphere - Student-focused note sharing platform",
  "dependencies": {
    "@prisma/orm-postgres": "^8.0.0-rc.18",
    "concurrently": "^9.1.2",
    "dotenv": "^18.0.8",
    "temporal-polyfill": "^1.0.4"
  },
  "devDependencies": {
    "@prisma/cli-engine": "^0.7.0",
    "@types/node": "^26.6.5",
    "prisma": "^8.0.0-rc.33",
    "typescript": "^6.0.3"
  }
}
