{
  "name": "notesphere",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "cd client/notesphere && npm start",
    "install-all": "npm install && cd server && npm install && cd ../client/notesphere && npm install",
    "contract:emit": "prisma contract emit",
    "db:init": "prisma db init",
    "db:update": "prisma db update",
    "migration:plan": "prisma migration plan",
    "db:migrate": "prisma db migrate",
    "db:verify": "prisma db verify",
    "data:import:mysql": "node server/scripts/importMysqlData.js",
    "vercel-build": "cd .. && npm install && npm run contract:emit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "NoteSphere - Student-focused note sharing platform",
  "dependencies": {
    "@prisma/orm-postgres": "^8.0.0-rc.18",
    "concurrently": "^9.1.2",
    "dotenv": "^18.0.8",
    "temporal-polyfill": "^1.0.4"
  },
  "devDependencies": {
    "@prisma/cli-engine": "^0.7.0",
    "@types/node": "^26.6.5",
    "prisma": "^8.0.0-rc.23",
    "typescript": "^6.0.3"
  }
}
