# Pooled PostgreSQL URL for the running API (for example, Neon from Vercel Marketplace).
DATABASE_URL="postgresql://user:password@host-pooler:5432/database?sslmode=require"

# Direct, unpooled URL for Prisma schema changes and the one-time data import.
DIRECT_URL="postgresql://user:password@host:5432/database?sslmode=require"

# MySQL source URL used only by the one-time migration importer.
MYSQL_DATABASE_URL="mysql://user:password@localhost:3306/notesphere_db"

# API configuration
JWT_SECRET=replace_with_a_long_random_secret
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
MAX_FILE_SIZE=10485760
