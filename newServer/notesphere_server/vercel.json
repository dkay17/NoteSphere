{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run contract:emit && npm run build",
  "devCommand": "npm run dev",
  "functions": {
    "src/app/api/**/route.ts": {
      "maxDuration": 30
    }
  }
}
